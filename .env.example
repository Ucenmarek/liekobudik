# Budík zo servera (web push). Bez týchto hodnôt appka funguje,
# len pripomína iba vtedy, keď je otvorená.

# Kľúče vygenerujete príkazom: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt na prevádzkovateľa, napr. mailto:meno@domena.sk
VAPID_SUBJECT=

# Upstash Redis (Vercel → Storage → Upstash doplní tieto dve hodnoty sám)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Heslo pre /api/push/tick, ktoré každú minútu volá plánovač
CRON_SECRET=
